# Copy to .env for LOCAL development only. In AWS these are injected by Terraform
# as AgentCore environment variables + a Secrets Manager reference. Never commit .env.

# --- Sublime Security ---
# Local dev: put the key here directly. In AWS, leave this unset and use
# SUBLIME_SECRET_ARN instead (the agent reads the key from Secrets Manager).
SUBLIME_API_KEY=
# SUBLIME_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:phishbowl/sublime-api-key
# Confirm your tenant's API base in the Sublime console (Settings ▸ API).
SUBLIME_API_BASE=https://api.platform.sublime.security

# --- Bedrock model ---
# Must be enabled in your account/region (Bedrock ▸ Model access).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
AWS_REGION=us-east-1

# --- Optional: IP reputation enrichment (off by default) ---
# PHISHBOWL_IP_ENRICHMENT=1
